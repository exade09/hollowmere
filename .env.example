# Token contract address. Set it in Vercel: Project -> Settings -> Environment Variables.
# While empty the site shows "address not spoken yet" and copying is disabled.
NEXT_PUBLIC_CONTRACT=
# Chain name shown on the sigil card. Defaults to "Robinhood Chain".
NEXT_PUBLIC_CHAIN=
# Token page prefix; the contract address is appended to it.
NEXT_PUBLIC_EXPLORER=
# Ticker. Defaults to HOLLOW.
NEXT_PUBLIC_TICKER=
# Canonical origin for OG tags. Vercel's production URL is used when unset.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------- the agent
# Which model writes the posts. "stub" needs no key and no network, and is the
# default: the agent can be built and tested before anyone pays for a token.
AI_PROVIDER=stub
# Server-only. NEVER prefix a key with NEXT_PUBLIC_ — that compiles it into the
# browser bundle and hands it to everyone who opens the page.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Shared secret for /api/agent/tick and /api/agent/review. Vercel Cron sends it
# as "Authorization: Bearer <CRON_SECRET>" on its own.
CRON_SECRET=
# Hours the agent waits between posts. Defaults to 8.
AGENT_MIN_GAP_HOURS=8
# Leave false. When false every dispatch is a draft until a human approves it
# at /api/agent/review, and nothing the model writes can reach the timeline or
# the raven on its own.
AGENT_AUTOPOST=false
# Durable store. Vercel's KV integration injects these two; Upstash's own
# dashboard calls them UPSTASH_REDIS_REST_*, and either pair works. With
# neither set the agent writes to .agent/state.json, which is local only.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# JSON-RPC endpoint for Robinhood Chain. Required for the agent to see the
# chain from a server: the Blockscout explorer sits behind a bot check and
# answers only browsers, so without this the agent simply writes posts that
# need no figures.
CHAIN_RPC_URL=
