# Token contract address. Set it in Vercel: Project -> Settings -> Environment Variables.
# While empty the site shows "address not spoken yet" and copying is disabled.
NEXT_PUBLIC_CONTRACT=
# Chain name shown on the sigil card. Defaults to "Robinhood Chain".
NEXT_PUBLIC_CHAIN=
# Token page prefix; the contract address is appended to it.
NEXT_PUBLIC_EXPLORER=
# Ticker. Defaults to HOLLOW.
NEXT_PUBLIC_TICKER=
# Chart page prefix for the raven's dispatch row; the live address is appended.
# The path carries the chain, so a token on one chain read through another
# chain's path is a dead link — this is the one to correct if the chain moves.
# Defaults to https://dexscreener.com/solana/
NEXT_PUBLIC_DEXSCREENER=
# Canonical origin for OG tags. Vercel's production URL is used when unset.
NEXT_PUBLIC_SITE_URL=

# Full-site launch cover. The site stays covered unless it is explicitly
# published. Set SITE_PUBLIC=true in Vercel and redeploy to reveal the site.
# This is server-only and must not use NEXT_PUBLIC_.
SITE_PUBLIC=false

# ---------------------------------------------------------------- the agent
# Which model writes the posts. "stub" needs no key and no network, and is the
# default: the agent can be built and tested before anyone pays for a token.
AI_PROVIDER=stub
# Server-only. NEVER prefix a key with NEXT_PUBLIC_ — that compiles it into the
# browser bundle and hands it to everyone who opens the page.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Shared secret for /api/agent/tick and /api/agent/review. Vercel Cron sends it
# as "Authorization: Bearer <CRON_SECRET>" on its own.
CRON_SECRET=
# Hours the agent waits between posts. Defaults to 8.
AGENT_MIN_GAP_HOURS=8
# Leave false. When false every dispatch is a draft until a human approves it
# at /api/agent/review, and nothing the model writes can reach the timeline or
# the raven on its own.
AGENT_AUTOPOST=false
# Durable store. Vercel's KV integration injects these two; Upstash's own
# dashboard calls them UPSTASH_REDIS_REST_*, and either pair works. With
# neither set the agent writes to .agent/state.json, which is local only.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# JSON-RPC endpoint for Robinhood Chain. Required for the agent to see the
# chain from a server: the Blockscout explorer sits behind a bot check and
# answers only browsers, so without this the agent simply writes posts that
# need no figures.
CHAIN_RPC_URL=
# Limits on /api/wick, the one endpoint where a visitor spends project money.
# Defaults: 4 a minute per visitor, 40 a day per visitor, 800 a day across
# everyone. The last one is the actual budget ceiling.
WICK_PER_MINUTE=4
WICK_PER_VISITOR_DAY=40
WICK_GLOBAL_DAY=800
TOKEN_PER_MINUTE=10
# Wallet readings are heavier than token ones: two log queries and up to eighty
# calls on somebody else's node. Defaults to 6 a minute per visitor.
WALLET_PER_MINUTE=6
# How many of a wallet's largest positions get their contract opened up —
# ownership, upgrade slot, code size, the owner's own share. Five calls each.
# Defaults to 5.
WALLET_DEEP_TOKENS=5
# Tokens always checked by name when reading a wallet, comma separated. The
# project's own contract is always included without being listed here. This is
# the reading that cannot be refused: with no index answering and a node that
# will not scan logs without a contract address, it is the only one left.
KNOWN_TOKENS=

# ----------------------------------------------------------- the address desk
# The password for /admin, where the text after "CA:" is changed without a
# deploy. Server-only: never prefix it with NEXT_PUBLIC_. While it is unset the
# desk refuses everything, which is the right default for a route that changes
# what address the site tells people to buy.
ADMIN_PASSWORD=
# Guesses allowed per minute per address. Defaults to 8.
ADMIN_TRIES_PER_MINUTE=8
# The desk needs KV to be useful in production: a serverless filesystem is
# read-only, so without KV_REST_API_URL and KV_REST_API_TOKEN above, a value
# written at the desk vanishes on the next cold start. The desk says so on
# screen when that is the case.
